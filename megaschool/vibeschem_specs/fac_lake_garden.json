   "id": "lake",
   "type": "script",
   "code": "const W=args.W, D=args.D, cx=args.cx, cz=args.cz;for (let x=0;x<W;x++) for (let z=0;z<D;z++) { const dx=(x-cx)/74, dz=(z-cz)/72; const r=Math.hypot(dx,dz) + 0.16*fbm(x/38, z/38, 0.5, 3); if (r<1.0) { set(x,-1,z,'water'); set(x,-2,z,'water'); set(x,-3,z,'lakebed');   if (r<0.98 && r>0.86 && chance(0.06)) set(x,0,z,'lily_pad'); } else if (r<1.07) { set(x,-1,z,'bank'); if (chance(0.25)) set(x,0,z, pick(['tall_grass','short_grass','fern'])); } else if (r>1.13 && r<1.20) { set(x,-1,z,'walk'); }}",
