   },
   "code": "const L=args.len; for (let i=0;i<=L;i++) { const t=i/L; const y=Math.round(5*Math.sin(Math.PI*t)) - 1; const x=args.x0+i; for (let w=-2; w<=2; w++) { set(x,y,args.z+w,'stone'); if (y>0) set(x,y-1,args.z+w,'stone'); } set(x,y+1,args.z-3,'stone_brick_wall'); set(x,y+1,args.z+3,'stone_brick_wall'); set(x,y,args.z-3,'stone'); set(x,y,args.z+3,'stone'); if (i%13==0) { set(x,y+2,args.z-3,'lantern'); set(x,y+2,args.z+3,'lantern'); } }"
