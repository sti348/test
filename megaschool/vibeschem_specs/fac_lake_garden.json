   },
   "code": "let x=args.x0, z=args.z0; const legs=[[1,0,10],[0,1,6],[1,0,10],[0,-1,6],[1,0,10],[0,1,4],[1,0,8]];for (const [dx,dz,n] of legs) for (let i=0;i<n;i++) { x+=dx; z+=dz; for (let a=-1;a<=1;a++) set(x+(dz?a:0),0,z+(dx?a:0),'spruce_slab[type=bottom]'); if (i%3==0) { set(x+(dz?2:0),0,z+(dx?2:0),'spruce_fence'); set(x-(dz?2:0),0,z-(dx?2:0),'spruce_fence'); } }"
